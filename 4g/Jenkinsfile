pipeline {
    agent any

    stages {
        stage('Check Prerequisites') {
            steps {
                script {
                    echo "=== Checking Docker and Docker Compose availability ==="
                    sh '''
                        echo "User: $(whoami)"
                        echo "UID: $(id -u)"
                        
                        # Check Docker
                        if ! command -v docker >/dev/null 2>&1; then
                            echo ""
                            echo "╔════════════════════════════════════════════════════════════════════════╗"
                            echo "║ ERROR: Docker is not installed on this Jenkins agent                   ║"
                            echo "╚════════════════════════════════════════════════════════════════════════╝"
                            echo ""
                            echo "To fix this, run the following commands on the Jenkins agent (as root/sudo):"
                            echo ""
                            echo "  # Install Docker (Ubuntu/Debian)"
                            echo "  sudo apt-get update"
                            echo "  sudo apt-get install -y ca-certificates curl"
                            echo "  sudo install -m 0755 -d /etc/apt/keyrings"
                            echo "  sudo curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc"
                            echo "  sudo chmod a+r /etc/apt/keyrings/docker.asc"
                            echo "  echo \"deb [arch=\$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu \$(. /etc/os-release && echo \$VERSION_CODENAME) stable\" | sudo tee /etc/apt/sources.list.d/docker.list > /dev/null"
                            echo "  sudo apt-get update"
                            echo "  sudo apt-get install -y docker-ce docker-ce-cli containerd.io docker-compose-plugin"
                            echo ""
                            echo "  # Add Jenkins user to docker group"
                            echo "  sudo usermod -aG docker jenkins"
                            echo "  sudo systemctl restart jenkins"
                            echo ""
                            echo "After installation, re-run this Jenkins job."
                            echo ""
                            exit 1
                        fi
                        docker --version
                        
                        # Check Docker Compose (v2 plugin or standalone)
                        if docker compose version >/dev/null 2>&1; then
                            echo "Docker Compose (plugin) found:"
                            docker compose version
                        elif command -v docker-compose >/dev/null 2>&1; then
                            echo "Docker Compose (standalone) found:"
                            docker-compose --version
                        else
                            echo ""
                            echo "╔════════════════════════════════════════════════════════════════════════╗"
                            echo "║ ERROR: Docker Compose is not available                                 ║"
                            echo "╚════════════════════════════════════════════════════════════════════════╝"
                            echo ""
                            echo "Docker is installed but Docker Compose plugin is missing."
                            echo "Run this on the Jenkins agent:"
                            echo ""
                            echo "  sudo apt-get update"
                            echo "  sudo apt-get install -y docker-compose-plugin"
                            echo ""
                            exit 1
                        fi
                        
                        # Verify Docker daemon is accessible
                        if ! docker ps >/dev/null 2>&1; then
                            echo ""
                            echo "╔════════════════════════════════════════════════════════════════════════╗"
                            echo "║ ERROR: Cannot connect to Docker daemon                                 ║"
                            echo "╚════════════════════════════════════════════════════════════════════════╝"
                            echo ""
                            echo "Docker is installed but the Jenkins user cannot access it."
                            echo "Possible fixes:"
                            echo ""
                            echo "  # Add jenkins user to docker group"
                            echo "  sudo usermod -aG docker jenkins"
                            echo "  sudo systemctl restart jenkins"
                            echo ""
                            echo "  # OR start Docker daemon if not running"
                            echo "  sudo systemctl start docker"
                            echo "  sudo systemctl enable docker"
                            echo ""
                            exit 1
                        fi
                        
                        echo ""
                        echo "✓ Prerequisites check passed"
                        echo ""
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                echo "Acceder au projet 4G"
                echo "Deploying containers with docker-compose (in 4G)"

                script {
                    // Find the correct directory (4G or 4g)
                    def projectDir = fileExists("${WORKSPACE}/4G") ? "4G" : "4g"
                    echo "Using directory: ${projectDir}"
                    
                    dir("${WORKSPACE}/${projectDir}") {
                        sh "sed -i 's/\r\$//' start.sh setup-cli.sh setup-internet-access.sh || true"
                        sh 'chmod +x start.sh setup-cli.sh setup-internet-access.sh'

                        sh './start.sh'
                        
                        echo "Install traceroute and speed test into your srsUE container"
                        sh './setup-cli.sh'

                        echo "Configure internet access via corenetwork"
                        sh './setup-internet-access.sh'
                    }
                }
            }
        }
    }
}
