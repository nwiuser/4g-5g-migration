pipeline {
    agent any

    stages {
        stage('Check Prerequisites') {
            steps {
                script {
                    echo "=== Checking Docker and Docker Compose availability ==="
                    sh '''
                        echo "User: $(whoami)"
                        echo "UID: $(id -u)"
                        
                        # Check Docker
                        if ! command -v docker >/dev/null 2>&1; then
                            echo "ERROR: Docker is not installed or not in PATH"
                            exit 1
                        fi
                        docker --version
                        
                        # Check Docker Compose (v2 plugin or standalone)
                        if docker compose version >/dev/null 2>&1; then
                            echo "Docker Compose (plugin) found:"
                            docker compose version
                        elif command -v docker-compose >/dev/null 2>&1; then
                            echo "Docker Compose (standalone) found:"
                            docker-compose --version
                        else
                            echo "ERROR: Docker Compose is not available."
                            echo "Please install docker-compose-plugin on the Jenkins agent."
                            echo "For Ubuntu/Debian: sudo apt-get update && sudo apt-get install -y docker-compose-plugin"
                            exit 1
                        fi
                        
                        # Verify Docker daemon is accessible
                        if ! docker ps >/dev/null 2>&1; then
                            echo "ERROR: Cannot connect to Docker daemon. Check permissions or Docker service status."
                            exit 1
                        fi
                        
                        echo "=== Prerequisites check passed ==="
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                echo "Acceder au projet 4G"
                echo "Deploying containers with docker-compose (in 4G)"

                dir("${WORKSPACE}/4G") {
                    sh "sed -i 's/\r\$//' start.sh setup-cli.sh setup-internet-access.sh || true"
                    sh 'chmod +x start.sh setup-cli.sh setup-internet-access.sh'

                    sh './start.sh'
                    
                    echo "Install traceroute and speed test into your srsUE container"
                    sh './setup-cli.sh'

                    echo "Configure internet access via corenetwork"
                    sh './setup-internet-access.sh'
                }
            }
        }
    }
}
